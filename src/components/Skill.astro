---
import type { IconType } from 'react-icons';

interface Props {
  name: string;
  color: string;
  Icon: IconType;
}

const { name, Icon, color } = Astro.props;
---

<div class="skill">
  <Icon />
  <span>{name}</span>
</div>

<style define:vars={{ color }}>
  .skill svg {
    color: white;
  }
  .skill {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    cursor: pointer;
    text-wrap: nowrap;
  }
  .skill svg {
    position: absolute;
    transition: all 0.4s ease;
  }
  .skill:hover svg {
    color: var(--color);
    transform: scale(1.2);
  }
  .skill span {
    position: relative;
    margin-left: 1.5rem;
    padding: 0 0.5rem;
    border-top-left-radius: 0.25rem;
    border-bottom-left-radius: 0.25rem;
    width: 0;
    background-image: linear-gradient(
      to right,
      var(--color),
      var(--background)
    );
    background-repeat: no-repeat;
    background-size: 0% 100%; /* collapsed by default */
    background-position: left center;
    transition: all 300ms ease-in;
  }

  .skill:hover span {
    margin-left: 2rem;
    width: 100%;
    /* keep same gradient; just expand it */
    background-size: 100% 100%;
    color: white;
    border-top-left-radius: 0.5rem;
    border-bottom-left-radius: 0.5rem;
    transition: all 700ms ease;
  }
</style>
